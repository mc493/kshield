def cmd_status():
    report = KShieldAudit.run_full_audit()
    host = report["host"]
    score = report["posture_score"]
    boundaries = report["boundaries"]
    mods = report["modules"]["summary"]

    score_color = "\033[92m" if score >= 80 else ("\033[93m" if score >= 50 else "\033[91m")
    reset = "\033[0m"

    print("═══════════════════════════════════════════════════════════════════════════")
    print("      [AEGIS-KERNEL]  AEGIS-KERNEL: LINUX SELF-DEFENSE POSTURE STATUS (UKDF)        ")
    print("═══════════════════════════════════════════════════════════════════════════")
    print(f"Host: {host['nodename']} | Kernel: {host['kernel_release']} ({host['machine']})")
    print(f"Overall Attack-Surface Score: {score_color}{score}/100{reset}")
    print("───────────────────────────────────────────────────────────────────────────")
    print("ENFORCEMENT GATES:")
    print(f"  • Seccomp Engine        : {'[OK] ACTIVE' if boundaries['seccomp_supported'] else '[ALERT] DISABLED'}")
    print(f"  • K8s Seccomp Profile   : {'[OK] INSTALLED' if boundaries['kshield_seccomp_profile_installed'] else '[INFO] NOT FOUND (/var/lib/kubelet/seccomp)'}")
    print(f"  • Modprobe Disarm Conf  : {'[OK] SEALED' if boundaries['kshield_disarm_conf_installed'] else '[INFO] UNSEALED (/etc/modprobe.d/kshield-disarm.conf)'}")
    print(f"  • User Namespaces       : {'[OK] CONFIGURED' if boundaries['user_namespaces_enabled'] else '[INFO] DISABLED'}")
    print(f"  • Root Filesystem VFS   : {'[OK] READ-ONLY' if boundaries.get('read_only_root') else '[INFO] READ-WRITE'}")
    print(f"  • Active LSMs           : {', '.join(boundaries['active_lsms']) if boundaries['active_lsms'] else 'Standard DAC'}")
    print("\nREACHABLE ATTACK SURFACE:")
    active_count = mods["active_risk_modules_in_ram"]
    active_ram_str = "[OK] 0 in RAM" if active_count == 0 else f"[WARN] {active_count} in RAM"
    print(f"  • Active Risk Modules   : {active_ram_str}")
    builtin_count = mods.get("built_in_kernel_modules", 0)
    if builtin_count > 0:
        print(f"  • Built-in Kernel Code  : [WARN] {builtin_count} non-modular (compiled as CONFIG_*=y)")
    dormant_count = mods["dormant_reachable_modules"]
    print(f"  • Dormant Reachable     : {dormant_count} loadable modules on disk")
    print("═══════════════════════════════════════════════════════════════════════════\n")


def cmd_audit(args):
    report = KShieldAudit.run_full_audit()
    if args.json:
        print(json.dumps(report, indent=2))
        return

    # Terminal Dashboard
    cmd_status()
    print("AUDIT FINDINGS BREAKDOWN:\n")

    print("[1] MODULE ATTACK SURFACE:")
    for cat, data in report["modules"].items():
        if cat == "summary":
            continue
        print(f"  • {cat.replace('_', ' ').title()}:")
        if data.get("active_in_ram"):
            print(f"    [ALERT] Active in RAM   : {', '.join(data['active_in_ram'])}")
        if data.get("built_in_kernel"):
            print(f"    [WARN] Built-in Kernel  : {', '.join(data['built_in_kernel'])} (Non-modular; cannot be sealed via modprobe)")
        if data.get("dormant_available"):
            dormant_preview = ', '.join(data['dormant_available'][:6])
            suffix = f" ... (+{len(data['dormant_available']) - 6} more)" if len(data['dormant_available']) > 6 else ""
            print(f"    [WARN] Dormant on Disk  : {dormant_preview}{suffix}")
        if data.get("disarmed_or_absent"):
            print(f"    [OK] Disarmed/Absent  : {len(data['disarmed_or_absent'])} modules safe")

    print("\n[2] CRITICAL SYSCTL AUDIT:")
    for key, data in report["sysctls"].items():
        status = "[OK] COMPLIANT" if data["compliant"] else "[WARN] DEFICIENT"
        print(f"  • {key:<35} : {status} (Current: {data['current']}, Target: {data['target']})")

    print("\n[3] DEFENSE TAXONOMY ALIGNMENT:")
    print("  • Category A (Vulnerability Remediation) : Upstream vendor kernel patch (replaces vulnerable C source)")
    print("  • Category B (Exploit-Path Prevention)   : Gating entry points (Seccomp drop, UserNS disable, modprobe redirect)")
    print("  • Category C (Exploit-Chain Hardening)   : Obfuscating KASLR pointers (kptr_restrict/dmesg), audit trail")

    print("\n───────────────────────────────────────────────────────────────────────────\n")


def cmd_disarm(args):
    report = KShieldAudit.run_full_audit()
    dormant = []
    for cat, data in report["modules"].items():
        if cat != "summary":
            dormant.extend(data["dormant_available"])

    profile = getattr(args, "profile", "container-host")
    no_icmp = getattr(args, "no_icmp", False)
    modprobe_content = KShieldDisarm.generate_modprobe_config(dormant)
    sysctl_content = KShieldDisarm.generate_sysctl_config(profile=profile)

    if args.dry_run or not args.enforce:
        print("═══════════════════════════════════════════════════════════════════════════")
        print("      [AEGIS-KERNEL]  AEGIS-KERNEL: DISARM STAGING PREVIEW (DRY-RUN)                ")
        print("═══════════════════════════════════════════════════════════════════════════")
        os.makedirs(STAGING_DIR, exist_ok=True)
        staged_modprobe = os.path.join(STAGING_DIR, "kshield-disarm.conf")
        staged_sysctl = os.path.join(STAGING_DIR, "99-kshield.conf")

        with open(staged_modprobe, "w") as f:
            f.write(modprobe_content)
        with open(staged_sysctl, "w") as f:
            f.write(sysctl_content)

        num_sysctls = len(SYSCTL_TARGETS) + (len(STRICT_SYSCTL_TARGETS) if profile == "strict-host" else 0)
        print(f"[DIR] Configurations successfully staged to: {STAGING_DIR}/\n")
        print(f"1. [{staged_modprobe}] ({len(dormant)} dormant modules targeted)")
        preview_lines = modprobe_content.split("\n")[:12]
        for l in preview_lines:
            print(f"   | {l}")
        print(f"   | ... (+{len(preview_lines)} more lines)\n")

        print(f"2. [{staged_sysctl}] ({num_sysctls} sysctl hardening directives - Profile: {profile})")
        for l in sysctl_content.split("\n")[:12]:
            print(f"   | {l}")
        print("   | ...\n")

        if report["boundaries"].get("read_only_root"):
            print("[INFO] Host root filesystem is mounted read-only.")
            print("       Enforcement utilizes volatile runtime configuration paths (/run/modprobe.d/ & /run/sysctl.d/).")
        else:
            print("[INFO] To apply live with 60-second watchdog: run 'kshield disarm --enforce'")
        print("═══════════════════════════════════════════════════════════════════════════\n")
        return

    # ENFORCE PATH
    if os.geteuid() != 0:
        print("[ERROR] Error: 'kshield disarm --enforce' requires root privileges (run with sudo).")
        sys.exit(1)

    is_ro = report["boundaries"].get("read_only_root")
    if is_ro:
        print("[INFO] Read-only root filesystem detected: Applying configuration via /run/modprobe.d & /run/sysctl.d.")
        target_modprobe_dir = "/run/modprobe.d"
        target_sysctl_dir = "/run/sysctl.d"
    else:
        target_modprobe_dir = "/etc/modprobe.d"
        target_sysctl_dir = "/etc/sysctl.d"

    os.makedirs(target_modprobe_dir, exist_ok=True)
    os.makedirs(target_sysctl_dir, exist_ok=True)
    target_modprobe = os.path.join(target_modprobe_dir, "kshield-disarm.conf")
    target_sysctl = os.path.join(target_sysctl_dir, "99-kshield.conf")

    # 1. Create Snapshot
    timestamp_id = time.strftime("snap-%Y%m%d-%H%M%S")
    snap_path = KShieldDisarm.create_snapshot(timestamp_id)
    print(f"[SNAPSHOT] Baseline snapshot created at: {snap_path}")

    # 2. Write Configurations
    print(f"[APPLY] Applying modprobe disarm rules to {target_modprobe}...")
    with open(target_modprobe, "w") as f:
        f.write(modprobe_content)

    print(f"[APPLY] Applying sysctl hardening rules to {target_sysctl}...")
    with open(target_sysctl, "w") as f:
        f.write(sysctl_content)

    # 3. Apply Sysctls Live
    subprocess.run(["sysctl", "-p", target_sysctl], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 4. Immediate Automated Health Check
    print("[HEALTH] Running immediate automated health checks...")
    healthy, diag = KShieldWatchdog.run_health_checks()
    if not healthy:
        print(f"[ALERT] Health checks FAILED immediately: {diag}")
        print("[REVERT] Rolling back changes instantly...")
        KShieldDisarm.restore_snapshot(timestamp_id)
        sys.exit(1)

    print("  [OK] Gateway Reachability : OK")
    print("  [OK] DNS Resolution       : OK")
    print("  [OK] Socket Allocation    : OK")
    print("  [OK] Systemd Services     : OK")

    # 5. Watchdog Countdown
    if not args.no_watchdog:
        timeout = args.timeout or 60
        print(f"\n[WAIT] WATCHDOG ACTIVE: Waiting {timeout} seconds for confirmation or failure...")
        print("   Press ENTER to confirm and persist, or Ctrl+C to trigger immediate rollback.")

        confirmed = False
        start_time = time.time()
        while time.time() - start_time < timeout:
            remaining = int(timeout - (time.time() - start_time))
            sys.stdout.write(f"\r   [TIMER] Time remaining: {remaining:02d}s | Confirm [ENTER] / Abort [Ctrl+C]: ")
            sys.stdout.flush()

            r, _, _ = select.select([sys.stdin], [], [], 1.0)
            if r:
                sys.stdin.readline()
                confirmed = True
                break

            # Periodic health poll during countdown
            p_ok, _ = KShieldWatchdog.run_health_checks()
            if not p_ok:
                print("\n[ALERT] Mid-countdown health regression detected! Triggering watchdog rollback...")
                KShieldDisarm.restore_snapshot(timestamp_id)
                sys.exit(1)

        print("")
        if not confirmed:
            print("[TIMEOUT] Watchdog timer expired without confirmation! Rolling back to pristine baseline...")
            KShieldDisarm.restore_snapshot(timestamp_id)
            sys.exit(1)

    print("[SUCCESS] Aegis-Kernel disarmament ENFORCED and PERSISTED successfully.")


def cmd_restore(args):
    if os.geteuid() != 0:
        print("[ERROR] Error: 'kshield restore' requires root privileges (run with sudo).")
        sys.exit(1)
    KShieldDisarm.restore_snapshot(args.snapshot_id)


def cmd_verify_sandbox(args):
    print("═══════════════════════════════════════════════════════════════════════════")
    print("      [AEGIS-KERNEL]  AEGIS-KERNEL: USER-SPACE EXPLOIT SANDBOX VERIFICATION        ")
    print("═══════════════════════════════════════════════════════════════════════════")
    
    seccomp_mode = 0
    try:
        with open("/proc/self/status", "r") as f:
            for line in f:
                if line.startswith("Seccomp:"):
                    seccomp_mode = int(line.split(":")[1].strip())
                    break
    except Exception:
        pass
    seccomp_desc = "ACTIVE (Mode 2 Filter)" if seccomp_mode == 2 else ("STRICT (Mode 1)" if seccomp_mode == 1 else "UNCONFINED (Mode 0 - Host)")
    print(f"Environment: Arch={ARCH} | PID={os.getpid()} | UID={os.getuid()} | Seccomp={seccomp_desc}")
    print("───────────────────────────────────────────────────────────────────────────")

    ok_workload = KShieldSandbox.test_normal_workload()
    probe_results = KShieldSandbox.test_blocked_primitives()
    avg_latency = KShieldSandbox.benchmark_latency(args.iterations or 100_000)

    print("───────────────────────────────────────────────────────────────────────────")
    # Assert whether blocked
    blocked_count = sum(1 for v in probe_results.values() if v in ("BLOCKED", "UNSUPPORTED"))
    container_gated = sum(1 for v in probe_results.values() if v == "HOST_PERMITTED")
    if seccomp_mode == 0:
        print(f"Exploit Gating Efficiency: {blocked_count} defanged on host, {container_gated} gated in Seccomp container profiles.")
    else:
        print(f"Exploit Gating Efficiency: {blocked_count}/{len(probe_results)} primitives defanged.")

    if ok_workload:
        print("[SUCCESS] SANDBOX INTEGRITY: 100% OPERATIONAL (Zero Regressions)")
    else:
        print("[WARN] SANDBOX INTEGRITY: Workload degradation detected.")
    print("═══════════════════════════════════════════════════════════════════════════\n")


def cmd_install_seccomp(args):
    candidates = []
    if getattr(args, "source", None):
        candidates.append(args.source)
    bin_dir = os.path.dirname(os.path.abspath(__file__))
    candidates.extend([
        os.path.join(bin_dir, "../profiles/seccomp-kshield-default.json"),
        os.path.join(bin_dir, "profiles/seccomp-kshield-default.json"),
        os.path.join(bin_dir, "seccomp-kshield-default.json"),
        "/usr/local/share/kshield/profiles/seccomp-kshield-default.json",
        "/etc/kshield/profiles/seccomp-kshield-default.json"
    ])

    source_profile = None
    for cand in candidates:
        if os.path.exists(cand):
            source_profile = os.path.abspath(cand)
            break

    if not source_profile:
        print("[ERROR] Source Seccomp profile (seccomp-kshield-default.json) not found in search paths:")
        for cand in candidates:
            print(f"  • {cand}")
        sys.exit(1)

    target_dir = args.target_dir or "/var/lib/kubelet/seccomp"
    try:
        os.makedirs(target_dir, exist_ok=True)
        dest_path = os.path.join(target_dir, "seccomp-kshield-default.json")
        shutil.copy2(source_profile, dest_path)
        print(f"[OK] Seccomp profile successfully installed to: {dest_path}")
    except PermissionError:
        print(f"[ERROR] Permission denied writing to {target_dir}. Run with sudo or ensure directory is writeable.")
        sys.exit(1)
    except Exception as e:
        print(f"[ERROR] Failed to install Seccomp profile: {e}")
        sys.exit(1)


def cmd_snapshots():
    if not os.path.exists(SNAPSHOT_DIR) or not os.listdir(SNAPSHOT_DIR):
        print("[INFO] No snapshots found in storage.")
        return

    print("═══════════════════════════════════════════════════════════════════════════")
    print("      [SNAPSHOT] AEGIS-KERNEL: RECORDED RECOVERY SNAPSHOTS                       ")
    print("═══════════════════════════════════════════════════════════════════════════")
    for snap in sorted(os.listdir(SNAPSHOT_DIR)):
        s_path = os.path.join(SNAPSHOT_DIR, snap)
        meta_file = os.path.join(s_path, "metadata.json")
        if os.path.exists(meta_file):
            try:
                with open(meta_file, "r") as f:
                    meta = json.load(f)
                dt = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(meta.get("timestamp", 0)))
                print(f"  • {snap} [{dt}] | Host: {meta.get('host')} | Kernel: {meta.get('kernel')}")
            except Exception:
                print(f"  • {snap} [corrupted metadata]")
        else:
            print(f"  • {snap}")
    print("═══════════════════════════════════════════════════════════════════════════\n")


# ============================================================================
# 5. CRYPTOGRAPHIC WORM LEDGER & DUAL-WITNESS NOTARY ENGINE
# ============================================================================

def _load_env_file():
    for p in [os.path.expanduser("~/.kshield.env"), "/etc/kshield/kshield.conf"]:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            k, v = k.strip(), v.strip().strip("\"'")
                            if k not in os.environ:
                                os.environ[k] = v
            except Exception:
                pass
            break

_load_env_file()

DEFAULT_VAULT_PATH = os.getenv("KSHIELD_VAULT_PATH", "/var/log/kshield/audit_chain.jsonl")
DEFAULT_WITNESS_STATUS = os.getenv("KSHIELD_WITNESS_STATUS", "/var/log/kshield/witness_status.json")
DEFAULT_WITNESS_HOST = os.getenv("KSHIELD_WITNESS_HOST", "127.0.0.1")
DEFAULT_SSH_USER = os.getenv("KSHIELD_SSH_USER", os.getenv("USER", "root"))
WORMD_BIN = os.getenv("KSHIELD_WORMD_BIN", shutil.which("kshield-wormd") or "/usr/local/bin/kshield-wormd")


class KShieldLedger:
    @staticmethod
    def compute_hash(index: int, timestamp: Any, topic: str, data: Any, prev_hash: str) -> str:
        data_str = json.dumps(data)
        raw = f"{index}|{timestamp}|{topic}|{data_str}|{prev_hash}"
        return hashlib.sha256(raw.encode("utf-8")).hexdigest()

    @classmethod
    def append_record(cls, topic: str, data: Any, path: str = DEFAULT_VAULT_PATH) -> Dict[str, Any]:
        """Atomically appends an attested, SHA-256 hash-chained record to the WORM ledger file with POSIX advisory locking."""
        vault_dir = os.path.dirname(os.path.abspath(path))
        if vault_dir:
            os.makedirs(vault_dir, exist_ok=True)

        lock_path = path + ".lock"
        with open(lock_path, "w") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            try:
                next_index = 0
                prev_hash = "0" * 64

                if os.path.exists(path) and os.path.getsize(path) > 0:
                    file_size = os.path.getsize(path)
                    with open(path, "rb") as f:
                        try:
                            if file_size > 65536:
                                f.seek(-65536, os.SEEK_END)
                                f.readline()  # discard potential partial line
                            else:
                                f.seek(0)
                        except OSError:
                            f.seek(0)
                        lines = f.read().decode("utf-8", errors="ignore").strip().splitlines()
                        if lines:
                            last_line = lines[-1].strip()
                            if last_line:
                                try:
                                    last_rec = json.loads(last_line)
                                    next_index = int(last_rec.get("index", 0)) + 1
                                    prev_hash = str(last_rec.get("hash", "0" * 64))
                                except Exception:
                                    pass

                timestamp = time.time()
                rec_hash = cls.compute_hash(next_index, timestamp, topic, data, prev_hash)
                record = {
                    "index": next_index,
                    "timestamp": timestamp,
                    "topic": topic,
                    "data": data,
                    "prev_hash": prev_hash,
                    "hash": rec_hash
                }

                line = json.dumps(record) + "\n"
                with open(path, "a", encoding="utf-8") as f:
                    f.write(line)
                    f.flush()
                    os.fsync(f.fileno())

                return {
                    "success": True,
                    "index": next_index,
                    "timestamp": timestamp,
                    "topic": topic,
                    "hash": rec_hash,
                    "prev_hash": prev_hash,
                    "vault_path": path
                }
            finally:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)

    @classmethod
    def verify_local_vault(cls, path: str = DEFAULT_VAULT_PATH, full_scan: bool = False) -> Dict[str, Any]:
        if not os.path.exists(path):
            return {"valid": False, "error": f"Vault ledger file not found at: {path}"}

        # If compiled WORM binary exists and full scan is requested, leverage acceleration
        if os.path.exists(WORMD_BIN) and full_scan:
            t0 = time.time()
            try:
                res = subprocess.run([WORMD_BIN, "--vault-path", path, "--verify"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
                dur = time.time() - t0
                if res.returncode == 0:
                    count = 0
                    m = re.search(r"across (\d+) records", res.stdout)
                    if m:
                        count = int(m.group(1))

                    head_idx = 0
                    head_hash = ""
                    with open(path, "rb") as f:
                        try:
                            f.seek(-4096, os.SEEK_END)
                        except OSError:
                            f.seek(0)
                        lines = f.read().decode("utf-8", errors="ignore").strip().splitlines()
                        if lines:
                            rec = json.loads(lines[-1])
                            head_idx = rec.get("index", 0)
                            head_hash = rec.get("hash", "")

                    return {
                        "valid": True,
                        "engine": "Native Rust WORM Engine",
                        "count": count,
                        "head_index": head_idx,
                        "head_hash": head_hash,
                        "duration_sec": dur,
                        "throughput": count / max(dur, 0.001),
                        "stdout": res.stdout.strip()
                    }
                else:
                    return {"valid": False, "error": res.stderr.strip() or res.stdout.strip()}
            except Exception:
                pass

        # Full sequential scan in pure Python if requested and external binary is absent
        if full_scan:
            t0 = time.time()
            head_idx = 0
            head_hash = ""
            count = 0
            last_rec = None
            try:
                with open(path, "r", encoding="utf-8") as f:
                    for line_num, line in enumerate(f):
                        line = line.strip()
                        if not line:
                            continue
                        rec = json.loads(line)
                        if last_rec is not None:
                            if rec.get("prev_hash") != last_rec.get("hash"):
                                return {
                                    "valid": False,
                                    "error": f"Hash chain broken between #{last_rec.get('index')} and #{rec.get('index')} at line {line_num+1}",
                                    "head_index": last_rec.get("index"),
                                    "head_hash": last_rec.get("hash")
                                }
                            calc = cls.compute_hash(rec["index"], rec["timestamp"], rec["topic"], rec["data"], rec["prev_hash"])
                            if calc != rec["hash"]:
                                return {
                                    "valid": False,
                                    "error": f"Cryptographic mismatch at index #{rec['index']} line {line_num+1}",
                                    "head_index": last_rec.get("index"),
                                    "head_hash": last_rec.get("hash")
                                }
                        last_rec = rec
                        count += 1
                if last_rec:
                    head_idx = last_rec.get("index", 0)
                    head_hash = last_rec.get("hash", "")
                dur = time.time() - t0
                return {
                    "valid": True,
                    "engine": "Python Stdlib (Full Sequential Verification)",
                    "count": count,
                    "head_index": head_idx,
                    "head_hash": head_hash,
                    "duration_sec": dur,
                    "full_scan": True,
                    "integrity_label": "100% UNBROKEN (All Sequential Records Validated)"
                }
            except Exception as e:
                return {"valid": False, "error": str(e)}

        # Fast tail verification (bounded read window)
        t0 = time.time()
        head_idx = 0
        head_hash = ""
        count = 0

        # Read last lines to verify head continuity
        try:
            file_size = os.path.getsize(path)
            with open(path, "rb") as f:
                try:
                    if file_size > 65536:
                        f.seek(-65536, os.SEEK_END)
                        f.readline()  # discard partial line
                    else:
                        f.seek(0)
                except OSError:
                    f.seek(0)
                lines = f.read().decode("utf-8", errors="ignore").strip().splitlines()

            last_rec = None
            for line in lines:
                line = line.strip()
                if not line:
                    continue
                rec = json.loads(line)
                if last_rec is not None:
                    if rec.get("prev_hash") != last_rec.get("hash"):
                        return {
                            "valid": False,
                            "error": f"Hash chain broken between #{last_rec.get('index')} and #{rec.get('index')}",
                            "head_index": head_idx,
                            "head_hash": head_hash
                        }
                    calc = cls.compute_hash(rec["index"], rec["timestamp"], rec["topic"], rec["data"], rec["prev_hash"])
                    if calc != rec["hash"]:
                        return {
                            "valid": False,
                            "error": f"Cryptographic mismatch at index #{rec['index']}",
                            "head_index": head_idx,
                            "head_hash": head_hash
                        }
                last_rec = rec
                count += 1

            if last_rec:
                head_idx = last_rec.get("index", 0)
                head_hash = last_rec.get("hash", "")

            # Estimate total records from line count or size
            est_total = head_idx + 1
            dur = time.time() - t0
            return {
                "valid": True,
                "engine": "Python Stdlib (Fast Tail Window Audit)",
                "count": est_total,
                "verified_tail_records": count,
                "head_index": head_idx,
                "head_hash": head_hash,
                "duration_sec": dur,
                "full_scan": False,
                "integrity_label": "VALID (Trailing Window Verified - use --full for complete scan)"
            }
        except Exception as e:
            return {"valid": False, "error": str(e)}

    @classmethod
    def query_remote_witness(cls, host: str = DEFAULT_WITNESS_HOST) -> Dict[str, Any]:
        if os.path.exists(DEFAULT_WITNESS_STATUS) and not os.path.exists(DEFAULT_VAULT_PATH):
            try:
                with open(DEFAULT_WITNESS_STATUS, "r") as f:
                    return json.load(f)
            except Exception as e:
                return {"status": "ERROR", "error": str(e)}

        user = DEFAULT_SSH_USER
        cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", f"{user}@{host}", f"cat {DEFAULT_WITNESS_STATUS}"]
        try:
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
            if res.returncode == 0:
                return json.loads(res.stdout.strip())
            else:
                return {"status": "UNREACHABLE", "error": res.stderr.strip()}
        except Exception as e:
            return {"status": "UNREACHABLE", "error": str(e)}


def cmd_verify_ledger(args):
    if not args.json:
        print("═══════════════════════════════════════════════════════════════════════════")
        print("      AEGIS-KERNEL: CRYPTOGRAPHIC WORM LEDGER & DUAL-WITNESS NOTARY   ")
        print("═══════════════════════════════════════════════════════════════════════════")
        print("Topology: Primary WORM Vault ⟷ Remote Dual-Witness Notary")
        print("───────────────────────────────────────────────────────────────────────────")

    vault_path = args.vault_path or DEFAULT_VAULT_PATH
    full_scan = getattr(args, "full", False)

    if not args.json:
        print(f"Auditing Primary Vault at {vault_path} ({'Full Scan' if full_scan else 'Tail Continuity'})...")
    local_res = KShieldLedger.verify_local_vault(vault_path, full_scan=full_scan)

    if not args.json:
        print(f"Querying Remote Dual-Witness Notary at {args.witness_host}...")
    witness_res = KShieldLedger.query_remote_witness(args.witness_host)

    if args.json:
        payload = {
            "primary_vault": local_res,
            "witness_notary": witness_res,
            "consensus": {}
        }
        if local_res.get("valid") and witness_res.get("status") == "HEALTHY":
            drift = abs(local_res.get("head_index", 0) - witness_res.get("head_index", 0))
            hash_match = local_res.get("head_hash") == witness_res.get("head_hash")
            payload["consensus"] = {
                "attested": hash_match and drift == 0,
                "index_drift": drift,
                "hash_match": hash_match
            }
        print(json.dumps(payload, indent=2))
        return

    # Render Report Table
    print("\nPRIMARY WORM VAULT")
    if local_res.get("valid"):
        print(f"  • Vault Path       : {vault_path}")
        print(f"  • Engine           : {local_res.get('engine')}")
        if local_res.get("full_scan"):
            print(f"  • Verified Records : {local_res.get('count', 0):,} (Full scan verified)")
        else:
            print(f"  • Estimated Records: ~{local_res.get('count', 0):,} (Based on head index)")
            print(f"  • Tail Verified    : {local_res.get('verified_tail_records', 0)} recent blocks")
        print(f"  • Head Index       : #{local_res.get('head_index')}")
        print(f"  • Head Hash        : {local_res.get('head_hash')[:16]}...{local_res.get('head_hash')[-8:]}")
        if "throughput" in local_res:
            print(f"  • Attestation Rate : {local_res.get('throughput', 0):,.0f} records/sec ({local_res.get('duration_sec', 0):.2f}s)")
        print(f"  • Chain Integrity  : {local_res.get('integrity_label', 'VALID')}")
    else:
        print(f"  • Status           : CORRUPTED / ERROR: {local_res.get('error')}")

    print("\nSECONDARY DUAL-WITNESS NOTARY")
    w_status = witness_res.get("status", "UNKNOWN")
    if w_status == "HEALTHY":
        print(f"  • Notary Host      : {args.witness_host}")
        print(f"  • Daemon Status    : HEALTHY (witness-notary)")
        print(f"  • Ledger Path      : {witness_res.get('ledger_path')}")
        print(f"  • Head Index       : #{witness_res.get('head_index')}")
        print(f"  • Head Hash        : {witness_res.get('head_hash')[:16]}...{witness_res.get('head_hash')[-8:]}")
        print(f"  • Reorder Buffer   : {witness_res.get('reorder_buffer_size', 0)} blocks queued")
        dead_man = "ACTIVE (Heartbeat Nominal)" if witness_res.get("dead_man_active") else "DEAD-MAN TRIPPED"
        print(f"  • Dead-Man Switch  : {dead_man}")
    else:
        print(f"  • Notary Host      : {args.witness_host}")
        print(f"  • Status           : {w_status} ({witness_res.get('error', 'No status telemetry')})")

    print("\n───────────────────────────────────────────────────────────────────────────")
    print("DUAL-WITNESS CONSENSUS VERDICT:")
    if local_res.get("valid") and w_status == "HEALTHY":
        l_idx = local_res.get("head_index", 0)
        w_idx = witness_res.get("head_index", 0)
        l_hash = local_res.get("head_hash", "")
        w_hash = witness_res.get("head_hash", "")
        drift = abs(l_idx - w_idx)

        print(f"  • Index Sync Drift : {drift} blocks")
        if l_hash == w_hash and drift == 0:
            print("  • Hash Divergence  : NONE (0.000% Divergence)")
            print("  • Consensus State  : CRYPTOGRAPHICALLY ATTESTED (Lockstep Consensus)")
        elif drift <= 5:
            print(f"  • Hash Divergence  : In-flight propagation delta ({drift} blocks)")
            print("  • Consensus State  : REAL-TIME CONVERGENT (Sub-second flight latency)")
        else:
            print("  • Hash Divergence  : DIVERGENT (Hash mismatch or sequence gap)")
            print("  • Consensus State  : CONSENSUS FAILED")
    else:
        print("  • Consensus State  : INCOMPLETE (One or more nodes unreachable/unverified)")
    print("═══════════════════════════════════════════════════════════════════════════\n")


def cmd_record_event(args):
    vault_path = args.vault_path or DEFAULT_VAULT_PATH
    raw_data = args.data
    try:
        data = json.loads(raw_data)
    except Exception:
        data = {"message": raw_data}

    res = KShieldLedger.append_record(topic=args.topic, data=data, path=vault_path)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print("═══════════════════════════════════════════════════════════════════════════")
        print("      AEGIS-KERNEL: CRYPTOGRAPHIC WORM LEDGER EVENT APPRENDER        ")
        print("═══════════════════════════════════════════════════════════════════════════")
        print(f"  • Vault Path       : {res['vault_path']}")
        print(f"  • Block Index      : #{res['index']}")
        print(f"  • Event Topic      : {res['topic']}")
        print(f"  • Previous Hash    : {res['prev_hash'][:16]}...{res['prev_hash'][-8:]}")
        print(f"  • Block Hash       : {res['hash']}")
        print(f"  • Status           : ATTESTED & COMMITTED")
        print("═══════════════════════════════════════════════════════════════════════════\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="kshield: Universal Kernel Defense Framework (UKDF) Unified CLI Core",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # status
    subparsers.add_parser("status", help="Displays current kernel defense posture and boundaries")

    # audit
    p_audit = subparsers.add_parser("audit", help="Executes deep passive attack-surface audit")
    p_audit.add_argument("--json", action="store_true", help="Output audit report in structured JSON format")

    # disarm
    p_disarm = subparsers.add_parser("disarm", help="Generates or applies fail-closed module sealing and sysctls")
    p_disarm.add_argument("--dry-run", action="store_true", help="Preview staged configurations without modifying host")
    p_disarm.add_argument("--enforce", action="store_true", help="Apply configurations live with automated watchdog")
    p_disarm.add_argument("--timeout", type=int, default=60, help="Watchdog rollback timeout in seconds (default: 60)")
    p_disarm.add_argument("--no-watchdog", action="store_true", help="Bypass the interactive watchdog countdown")
    p_disarm.add_argument("--profile", type=str, choices=["container-host", "strict-host"], default="container-host", help="Hardening profile ('container-host' preserves UserNS for container isolation; 'strict-host' sets user.max_user_namespaces=0)")
    p_disarm.add_argument("--no-icmp", action="store_true", help="Bypass ICMP ping in watchdog health checks (for cloud VPCs)")

    # restore
    p_restore = subparsers.add_parser("restore", help="Roll back host configurations from a snapshot")
    p_restore.add_argument("--snapshot-id", type=str, help="Specific snapshot ID to restore (default: most recent)")

    # verify-sandbox
    p_verify = subparsers.add_parser("verify-sandbox", help="Executes non-destructive exploit probing and latency benchmarks")
    p_verify.add_argument("--iterations", type=int, default=100_000, help="Number of iterations for syscall latency benchmark")

    # install-seccomp
    p_seccomp = subparsers.add_parser("install-seccomp", help="Installs seccomp-kshield-default.json to Kubelet")
    p_seccomp.add_argument("--target-dir", type=str, default="/var/lib/kubelet/seccomp", help="Target seccomp directory")
    p_seccomp.add_argument("--source", type=str, default=None, help="Custom path to source seccomp profile JSON")

    # snapshots
    subparsers.add_parser("snapshots", help="Lists existing baseline snapshots")

    # verify-ledger
    p_ledger = subparsers.add_parser("verify-ledger", help="Cryptographic audit chain and cross-node dual-witness notary attestation")
    p_ledger.add_argument("--vault-path", type=str, default=DEFAULT_VAULT_PATH, help="Path to local WORM vault ledger")
    p_ledger.add_argument("--witness-host", type=str, default=DEFAULT_WITNESS_HOST, help="Remote dual-witness host IP or hostname (default: 127.0.0.1 or KSHIELD_WITNESS_HOST)")
    p_ledger.add_argument("--full", action="store_true", help="Execute complete cryptovalidation scan across all records")
    p_ledger.add_argument("--json", action="store_true", help="Output attestation in structured JSON format")

    # record-event
    p_record = subparsers.add_parser("record-event", help="Appends an authenticated event to the local hash-chained WORM ledger")
    p_record.add_argument("--topic", type=str, required=True, help="Event topic identifier (e.g. security.audit.disarm)")
    p_record.add_argument("--data", type=str, required=True, help="Event payload JSON string or text message")
    p_record.add_argument("--vault-path", type=str, default=DEFAULT_VAULT_PATH, help="Path to local WORM vault ledger")
    p_record.add_argument("--json", action="store_true", help="Output attestation in structured JSON format")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "status":
        cmd_status()
    elif args.command == "audit":
        cmd_audit(args)
    elif args.command == "disarm":
        cmd_disarm(args)
    elif args.command == "restore":
        cmd_restore(args)
    elif args.command == "verify-sandbox":
        cmd_verify_sandbox(args)
    elif args.command == "install-seccomp":
        cmd_install_seccomp(args)
    elif args.command == "snapshots":
        cmd_snapshots()
    elif args.command == "verify-ledger":
        cmd_verify_ledger(args)
    elif args.command == "record-event":
        cmd_record_event(args)


if __name__ == "__main__":
    main()
