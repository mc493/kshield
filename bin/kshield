#!/usr/bin/env python3
"""
kshield.py — Universal Kernel Defense Framework (UKDF) Unified CLI Core
Project Aegis-Kernel | Enterprise Systems Architecture

Zero-dependency, production-grade Linux kernel attack-surface defense engine:
1. status          : Displays real-time kernel defense posture, boundaries & active locks
2. audit           : Deep attack-surface audit (modules, sysctls, LSMs, score 0-100)
3. disarm          : Generates or applies fail-closed module sealing & sysctl baselines
4. restore         : Transactional instant rollback from cryptographic snapshot
5. verify-sandbox  : Non-destructive exploit probing & syscall latency micro-benchmark
6. install-seccomp : Validates & installs Kubernetes/containerd Seccomp profile
7. snapshots       : Lists existing recovery snapshots and their attestation hashes

Adheres to Production SRE Standards & UKDF Safety Invariants.
"""

import sys
import os
import time
import socket
import select
import shutil
import hashlib
import threading
import subprocess
import argparse
import json
import re
import ctypes
import fcntl
from typing import Dict, List, Any, Tuple, Optional

libc = ctypes.CDLL(None, use_errno=True)

ARCH = os.uname().machine

# Syscall mapping across architectures
if ARCH == "x86_64":
    NR_userfaultfd = 323
    NR_io_uring_setup = 425
    NR_kexec_load = 246
    NR_getpid = 39
elif ARCH in ("aarch64", "arm64"):
    NR_userfaultfd = 282
    NR_io_uring_setup = 425
    NR_kexec_load = 104
    NR_getpid = 172
else:
    NR_userfaultfd = -1
    NR_io_uring_setup = -1
    NR_kexec_load = -1
    NR_getpid = -1

# High-risk / legacy kernel modules catalog
MODULE_CATALOG = {
    "obsolete_network_protocols": [
        "dccp", "dccp_ipv4", "dccp_ipv6",
        "sctp", "rds", "rds_tcp", "tipc",
        "ax25", "netrom", "x25", "rose",
        "decnet", "econet", "af_802154",
        "appletalk", "ipx", "psnap", "p8023", "p8022",
        "can", "can_raw", "can_bcm", "atm"
    ],
    "legacy_filesystems": [
        "cramfs", "freevxfs", "jffs2", "hfs", "hfsplus",
        "udf", "gfs2", "reiserfs", "minix", "adfs",
        "affs", "befs", "bfs", "efs", "qnx4", "qnx6", "sysv"
    ],
    "netfilter_legacy": [
        "ebtables", "ebtable_nat", "ebtable_filter", "ebtable_broute",
        "ebt_snat", "ebt_dnat", "ebt_arpreply",
        "arp_tables", "arptable_filter"
    ],
    "legacy_hardware_drivers": [
        "firewire-core", "firewire_ohci", "floppy", "vivid"
    ]
}

# Sysctl hardening targets
SYSCTL_TARGETS = {
    "kernel.unprivileged_bpf_disabled": {"target": [1, 2], "default_set": 1, "weight": 15, "desc": "Restrict BPF execution to privileged root"},
    "kernel.kptr_restrict": {"target": [1, 2], "default_set": 2, "weight": 10, "desc": "Obfuscate kernel pointer addresses in /proc"},
    "kernel.dmesg_restrict": {"target": [1], "default_set": 1, "weight": 10, "desc": "Restrict dmesg syslog buffer to privileged root"},
    "kernel.yama.ptrace_scope": {"target": [1, 2, 3], "default_set": 2, "weight": 10, "desc": "Restrict ptrace process memory inspection"},
    "kernel.kexec_load_disabled": {"target": [1], "default_set": 1, "weight": 10, "desc": "Block arbitrary kernel image replacement (one-way)"},
    "vm.unprivileged_userfaultfd": {"target": [0], "default_set": 0, "weight": 10, "desc": "Disable unprivileged heap race exploitation (userfaultfd)"},
    "fs.protected_symlinks": {"target": [1], "default_set": 1, "weight": 5, "desc": "Prevent TOCTOU symlink traversal attacks"},
    "fs.protected_hardlinks": {"target": [1], "default_set": 1, "weight": 5, "desc": "Prevent hardlink permission bypasses"},
    "fs.protected_fifos": {"target": [1, 2], "default_set": 2, "weight": 5, "desc": "Prevent spoofed FIFO file writes in world-writable dirs"},
    "fs.protected_regular": {"target": [1, 2], "default_set": 2, "weight": 5, "desc": "Prevent regular file write truncation in sticky dirs"},
    "kernel.perf_event_paranoid": {"target": [2, 3, 4], "default_set": 2, "weight": 5, "desc": "Restrict hardware performance counter side-channels"}
}

# Optional targets for strict non-container host profile
STRICT_SYSCTL_TARGETS = {
    "user.max_user_namespaces": {"target": [0], "default_set": 0, "weight": 5, "desc": "Disable unprivileged user namespaces (strict non-container host)"}
}

# Snapshot base directory
SNAPSHOT_DIR = os.path.expanduser("~/.kshield/snapshots")
STAGING_DIR = os.path.expanduser("~/.kshield/staging")


# ============================================================================
# 1. PASSIVE AUDIT ENGINE
# ============================================================================

class KShieldAudit:
    @staticmethod
    def get_loaded_modules() -> set:
        loaded = set()
        if os.path.exists("/proc/modules"):
            try:
                with open("/proc/modules", "r") as f:
                    for line in f:
                        parts = line.strip().split()
                        if parts:
                            loaded.add(parts[0])
            except Exception:
                pass
        return loaded

    @staticmethod
    def get_available_module_names() -> set:
        available = set()
        uname_r = os.uname().release
        mod_dir = f"/lib/modules/{uname_r}"
        if os.path.exists(mod_dir):
            modules_dep = os.path.join(mod_dir, "modules.dep")
            if os.path.exists(modules_dep):
                try:
                    with open(modules_dep, "r") as f:
                        for line in f:
                            if ":" in line:
                                path = line.split(":")[0].strip()
                                name = os.path.basename(path).split(".")[0].replace("-", "_")
                                available.add(name)
                except Exception:
                    pass
        return available

    @staticmethod
    def get_builtin_module_names() -> set:
        builtin = set()
        uname_r = os.uname().release
        builtin_path = f"/lib/modules/{uname_r}/modules.builtin"
        if os.path.exists(builtin_path):
            try:
                with open(builtin_path, "r") as f:
                    for line in f:
                        line = line.strip()
                        if line:
                            name = os.path.basename(line).split(".")[0].replace("-", "_")
                            builtin.add(name)
            except Exception:
                pass
        return builtin

    @staticmethod
    def read_sysctl(key: str) -> Tuple[bool, Any]:
        path = os.path.join("/proc/sys", key.replace(".", "/"))
        if os.path.exists(path):
            try:
                with open(path, "r") as f:
                    val = f.read().strip()
                    try:
                        return True, int(val)
                    except ValueError:
                        return True, val
            except Exception:
                return False, None
        return False, None

    @staticmethod
    def audit_boundaries() -> Dict[str, Any]:
        boundaries = {}
        # LSMs
        lsm_path = "/sys/kernel/security/lsm"
        if os.path.exists(lsm_path):
            try:
                with open(lsm_path, "r") as f:
                    boundaries["active_lsms"] = f.read().strip().split(",")
            except Exception:
                boundaries["active_lsms"] = []
        else:
            boundaries["active_lsms"] = []

        # Seccomp
        try:
            with open("/proc/self/status", "r") as f:
                status_text = f.read()
                m = re.search(r"^Seccomp:\s+(\d+)", status_text, re.MULTILINE)
                boundaries["seccomp_supported"] = m is not None
                boundaries["current_process_seccomp"] = int(m.group(1)) if m else 0
        except Exception:
            boundaries["seccomp_supported"] = False
            boundaries["current_process_seccomp"] = 0

        # Container Runtime Presence Detection
        has_container = bool(
            os.path.exists("/var/lib/kubelet") or
            os.path.exists("/run/containerd") or
            os.path.exists("/var/run/docker.sock") or
            shutil.which("docker") or
            shutil.which("k3s") or
            shutil.which("podman")
        )
        boundaries["container_runtime_present"] = has_container

        # UserNS
        exists, max_userns = KShieldAudit.read_sysctl("user.max_user_namespaces")
        exists_clone, val_clone = KShieldAudit.read_sysctl("kernel.unprivileged_userns_clone")
        userns_disabled = (exists and max_userns == 0) or (exists_clone and val_clone == 0)
        boundaries["unprivileged_userns_restricted"] = userns_disabled
        boundaries["user_namespaces_enabled"] = not userns_disabled
        boundaries["max_user_namespaces"] = max_userns

        # Read-Only Root Filesystem Detection
        is_ro = False
        try:
            with open("/proc/mounts", "r") as f:
                for line in f:
                    parts = line.strip().split()
                    if len(parts) >= 4 and parts[1] == "/":
                        if "ro" in parts[3].split(","):
                            is_ro = True
        except Exception:
            pass
        boundaries["read_only_root"] = is_ro

        # Kubelet Seccomp Profile Installed
        seccomp_profile_path = "/var/lib/kubelet/seccomp/seccomp-kshield-default.json"
        boundaries["kshield_seccomp_profile_installed"] = os.path.exists(seccomp_profile_path)

        # Modprobe Disarm Config Installed (/run/modprobe.d prioritized over /etc/modprobe.d)
        run_disarm = "/run/modprobe.d/kshield-disarm.conf"
        etc_disarm = "/etc/modprobe.d/kshield-disarm.conf"
        boundaries["kshield_disarm_conf_installed"] = os.path.exists(run_disarm) or os.path.exists(etc_disarm)
        boundaries["kshield_disarm_conf_path"] = run_disarm if os.path.exists(run_disarm) else (etc_disarm if os.path.exists(etc_disarm) else None)

        return boundaries

    @staticmethod
    def audit_modules() -> Dict[str, Any]:
        loaded = KShieldAudit.get_loaded_modules()
        available = KShieldAudit.get_available_module_names()
        builtin = KShieldAudit.get_builtin_module_names()
        results = {}
        total_risk_dormant = 0
        total_risk_active = 0
        total_risk_builtin = 0

        for category, modules in MODULE_CATALOG.items():
            results[category] = {
                "active_in_ram": [],
                "built_in_kernel": [],
                "dormant_available": [],
                "disarmed_or_absent": []
            }
            for mod in modules:
                mod_norm = mod.replace("-", "_")
                if mod_norm in loaded or mod in loaded:
                    results[category]["active_in_ram"].append(mod)
                    total_risk_active += 1
                elif mod_norm in builtin or mod in builtin:
                    results[category]["built_in_kernel"].append(mod)
                    total_risk_builtin += 1
                elif mod_norm in available or mod in available:
                    results[category]["dormant_available"].append(mod)
                    total_risk_dormant += 1
                else:
                    results[category]["disarmed_or_absent"].append(mod)

        results["summary"] = {
            "active_risk_modules_in_ram": total_risk_active,
            "built_in_kernel_modules": total_risk_builtin,
            "dormant_reachable_modules": total_risk_dormant
        }
        return results

    @staticmethod
    def audit_sysctls() -> Tuple[Dict[str, Any], int, int]:
        results = {}
        earned_score = 0
        total_score = 0

        for key, spec in SYSCTL_TARGETS.items():
            total_score += spec["weight"]
            exists, current_val = KShieldAudit.read_sysctl(key)
            compliant = exists and (current_val in spec["target"])
            if compliant:
                earned_score += spec["weight"]

            results[key] = {
                "current": current_val if exists else "NOT_FOUND",
                "compliant": compliant,
                "target": spec["target"],
                "description": spec["desc"]
            }

        return results, earned_score, total_score

    @staticmethod
    def compute_posture_score(sysctl_earned: int, sysctl_total: int, mod_summary: Dict[str, int], boundaries: Dict[str, Any]) -> int:
        sysctl_ratio = sysctl_earned / max(1, sysctl_total)
        score = sysctl_ratio * 60.0

        active_in_ram = mod_summary.get("active_risk_modules_in_ram", 0)
        dormant = mod_summary.get("dormant_reachable_modules", 0)
        mod_score = 20.0 - (active_in_ram * 5.0) - (min(dormant, 10) * 1.0)
        score += max(0.0, mod_score)

        if boundaries.get("seccomp_supported"):
            score += 5.0
        if "bpf" in boundaries.get("active_lsms", []):
            score += 5.0
        if boundaries.get("read_only_root"):
            score += 5.0
        # User namespace evaluation:
        # On container hosts, user namespaces are used for rootless container execution (e.g. K8s hostUsers: false).
        # On non-container hosts, restricting unprivileged user namespaces prevents local privilege escalation.
        has_container = boundaries.get("container_runtime_present", False)
        userns_restricted = boundaries.get("unprivileged_userns_restricted", False)
        if has_container:
            if boundaries.get("user_namespaces_enabled"):
                score += 5.0
        else:
            if userns_restricted:
                score += 5.0
            else:
                score += 2.0

        return int(min(100, max(0, score)))

    @classmethod
    def run_full_audit(cls) -> Dict[str, Any]:
        uname = os.uname()
        mod_findings = cls.audit_modules()
        sysctl_findings, earned, total = cls.audit_sysctls()
        boundary_findings = cls.audit_boundaries()
        score = cls.compute_posture_score(earned, total, mod_findings["summary"], boundary_findings)

        return {
            "host": {
                "nodename": uname.nodename,
                "kernel_release": uname.release,
                "machine": uname.machine
            },
            "posture_score": score,
            "boundaries": boundary_findings,
            "modules": mod_findings,
            "sysctls": sysctl_findings
        }


# ============================================================================
# 2. WATCHDOG & HEALTH MONITOR
# ============================================================================

class KShieldWatchdog:
    @staticmethod
    def get_default_gateway() -> Optional[str]:
        """Parses /proc/net/route to find the default IPv4 gateway."""
        try:
            with open("/proc/net/route", "r") as f:
                for line in f:
                    parts = line.strip().split()
                    if len(parts) >= 3 and parts[1] == "00000000":
                        gw_hex = parts[2]
                        # Hex to IPv4
                        octets = [str(int(gw_hex[i:i+2], 16)) for i in (6, 4, 2, 0)]
                        return ".".join(octets)
        except Exception:
            pass
        return None

    @staticmethod
    def check_gateway_reachability(no_icmp: bool = False) -> bool:
        """Verifies default gateway reachability using ICMP ping, active Layer 4 TCP probing, or routing table verification."""
        gw = KShieldWatchdog.get_default_gateway()
        if not gw:
            return True  # Cannot determine gateway; pass conservatively

        # 1. ICMP ping probe (primary)
        if not no_icmp:
            res = subprocess.run(["ping", "-c", "1", "-W", "1", gw], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return True

        # 2. Active Layer 4 TCP egress probe to default gateway
        # Connects to common gateway ports (DNS 53, HTTPS 443, HTTP 80, SSH 22).
        # Return code 0 (connected) or 111 (ECONNREFUSED) confirms Layer 2 ARP resolution and active packet exchange.
        probe_ports = [53, 443, 80, 22]
        for port in probe_ports:
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(1.0)
                rc = s.connect_ex((gw, port))
                s.close()
                if rc in (0, 111):
                    return True
            except Exception:
                pass

        # 3. Layer 3 interface operstate check on default routing interface
        try:
            with open("/proc/net/route", "r") as f:
                lines = f.readlines()
                for line in lines[1:]:
                    parts = line.strip().split()
                    if len(parts) >= 2 and parts[1] == "00000000":  # default route exists
                        iface = parts[0]
                        oper_path = f"/sys/class/net/{iface}/operstate"
                        if os.path.exists(oper_path):
                            with open(oper_path, "r") as op_f:
                                oper = op_f.read().strip()
                                if oper in ("up", "unknown"):
                                    return True
                        else:
                            return True
        except Exception:
            pass

        return False

    @staticmethod
    def check_dns_resolution(detailed: bool = False) -> Any:
        """Validates operational DNS resolution against public resolvers, local nameservers, or host fallback."""
        # 1. Probe reliable public DNS targets
        test_hosts = ["dns.quad9.net", "one.one.one.one", "kernel.org", "google.com"]
        for host in test_hosts:
            try:
                socket.getaddrinfo(host, 53, socket.AF_INET, socket.SOCK_STREAM)
                return (True, "verified") if detailed else True
            except Exception:
                continue

        # 2. Wire-level RFC 1035 UDP query probe against configured nameservers in /etc/resolv.conf
        if os.path.exists("/etc/resolv.conf"):
            nameservers = []
            try:
                with open("/etc/resolv.conf", "r") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("nameserver"):
                            parts = line.split()
                            if len(parts) >= 2:
                                nameservers.append(parts[1])
                # Minimal RFC 1035 root zone query: 17 bytes (ID 0x7b5a, RD=1, QDCOUNT=1, QNAME=., QTYPE=A, QCLASS=IN)
                dns_query = b"\x7b\x5a\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01"
                for ns in nameservers:
                    try:
                        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                        s.settimeout(1.0)
                        s.sendto(dns_query, (ns, 53))
                        resp, _ = s.recvfrom(512)
                        s.close()
                        if len(resp) >= 12 and resp[:2] == b"\x7b\x5a":
                            return (True, f"nameserver_verified ({ns})") if detailed else True
                    except Exception:
                        pass
            except Exception:
                pass

        # 3. Fallback for air-gapped / isolated local environments
        try:
            socket.gethostbyname("localhost")
            if os.path.exists("/etc/resolv.conf"):
                return (True, "degraded (local only)") if detailed else True
        except Exception:
            pass

        return (False, "unresolved") if detailed else False

    @staticmethod
    def check_socket_creation() -> bool:
        """Validates that standard TCP/UDP and UNIX domain sockets can still be allocated."""
        try:
            s1 = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s1.close()
            s2 = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s2.close()
            return True
        except Exception:
            return False

    @staticmethod
    def check_systemd_health() -> Tuple[bool, List[str]]:
        """Checks for newly failed systemd services."""
        try:
            res = subprocess.run(["systemctl", "--failed", "--plain", "--no-legend"], capture_output=True, text=True)
            failed_units = []
            for line in res.stdout.strip().split("\n"):
                if line.strip():
                    failed_units.append(line.split()[0])
            return len(failed_units) == 0, failed_units
        except Exception:
            return True, []

    @classmethod
    def run_health_checks(cls, no_icmp: bool = False) -> Tuple[bool, Dict[str, Any]]:
        results = {}
        gw_ok = cls.check_gateway_reachability(no_icmp=no_icmp)
        dns_ok, dns_status = cls.check_dns_resolution(detailed=True)
        sock_ok = cls.check_socket_creation()
        sysd_ok, failed = cls.check_systemd_health()

        results["gateway_reachability"] = gw_ok
        results["dns_resolution"] = dns_ok
        results["dns_status"] = dns_status
        results["socket_creation"] = sock_ok
        results["systemd_units_healthy"] = sysd_ok
        if failed:
            results["failed_units"] = failed

        overall = gw_ok and dns_ok and sock_ok
        return overall, results


# ============================================================================
# 3. DISARM & RESTORATION ENGINE
# ============================================================================

class KShieldDisarm:
    @staticmethod
    def generate_modprobe_config(dormant_modules: List[str]) -> str:
        lines = [
            "# ═══════════════════════════════════════════════════════════════════════════",
            "# UKDF / Aegis-Kernel: Automated Universal Modprobe Sealing Configuration",
            "# Intercepts on-demand module requests with /bin/true (exit code 0)",
            "# Generated automatically by: kshield disarm",
            "# ═══════════════════════════════════════════════════════════════════════════\n"
        ]
        all_to_seal = sorted(list(set(dormant_modules)))
        for mod in all_to_seal:
            lines.append(f"install {mod} /bin/true")
        lines.append("")
        for mod in all_to_seal:
            lines.append(f"blacklist {mod}")
        lines.append("")
        return "\n".join(lines)

    @staticmethod
    def generate_sysctl_config(profile: str = "container-host") -> str:
        lines = [
            "# ═══════════════════════════════════════════════════════════════════════════",
            "# UKDF / Aegis-Kernel: Automated Sysctl Defense Baseline",
            f"# Profile: {profile}",
            "# Enforces kernel memory obfuscation, unprivileged BPF disarming & link guards",
            "# Generated automatically by: kshield disarm",
            "# ═══════════════════════════════════════════════════════════════════════════\n"
        ]
        for key, spec in SYSCTL_TARGETS.items():
            lines.append(f"# {spec['desc']}")
            lines.append(f"{key} = {spec['default_set']}\n")

        if profile == "strict-host":
            for key, spec in STRICT_SYSCTL_TARGETS.items():
                lines.append(f"# {spec['desc']}")
                lines.append(f"{key} = {spec['default_set']}\n")

        return "\n".join(lines)

    @staticmethod
    def create_snapshot(snapshot_id: str) -> str:
        snap_path = os.path.join(SNAPSHOT_DIR, snapshot_id)
        os.makedirs(snap_path, exist_ok=True)

        digests = {}

        # Copy existing /etc/modprobe.d/kshield-disarm.conf if exists
        target_modprobe = "/etc/modprobe.d/kshield-disarm.conf"
        if os.path.exists(target_modprobe):
            dest_modprobe = os.path.join(snap_path, "kshield-disarm.conf")
            shutil.copy2(target_modprobe, dest_modprobe)
            with open(dest_modprobe, "rb") as f:
                digests["kshield-disarm.conf"] = hashlib.sha256(f.read()).hexdigest()

        # Copy existing /etc/sysctl.d/99-kshield.conf if exists
        target_sysctl = "/etc/sysctl.d/99-kshield.conf"
        if os.path.exists(target_sysctl):
            dest_sysctl = os.path.join(snap_path, "99-kshield.conf")
            shutil.copy2(target_sysctl, dest_sysctl)
            with open(dest_sysctl, "rb") as f:
                digests["99-kshield.conf"] = hashlib.sha256(f.read()).hexdigest()

        # Record current sysctl live values
        current_sysctls = {}
        for key in list(SYSCTL_TARGETS.keys()) + list(STRICT_SYSCTL_TARGETS.keys()):
            exists, val = KShieldAudit.read_sysctl(key)
            if exists:
                current_sysctls[key] = val

        with open(os.path.join(snap_path, "sysctl_baseline.json"), "w") as f:
            json.dump(current_sysctls, f, indent=2)

        meta = {
            "snapshot_id": snapshot_id,
            "timestamp": time.time(),
            "kernel": os.uname().release,
            "host": os.uname().nodename,
            "file_digests": digests
        }
        with open(os.path.join(snap_path, "metadata.json"), "w") as f:
            json.dump(meta, f, indent=2)

        return snap_path

    @staticmethod
    def restore_snapshot(snapshot_id: Optional[str] = None) -> bool:
        if not os.path.exists(SNAPSHOT_DIR):
            print("[ERROR] No snapshots found in storage.")
            return False

        available = sorted(os.listdir(SNAPSHOT_DIR))
        if not available:
            print("[ERROR] Snapshot storage directory is empty.")
            return False

        if snapshot_id:
            if snapshot_id not in available:
                print(f"[ERROR] Snapshot '{snapshot_id}' not found.")
                return False
            target_snap = snapshot_id
        else:
            # Use most recent
            target_snap = available[-1]

        snap_path = os.path.join(SNAPSHOT_DIR, target_snap)
        print(f"[REVERT] Restoring system state from snapshot: {target_snap} ...")

        meta_file = os.path.join(snap_path, "metadata.json")
        digests = {}
        if os.path.exists(meta_file):
            try:
                with open(meta_file, "r") as f:
                    meta = json.load(f)
                    digests = meta.get("file_digests", {})
            except Exception:
                pass

        # 1. Restore or remove modprobe config
        target_modprobe = "/etc/modprobe.d/kshield-disarm.conf"
        snap_modprobe = os.path.join(snap_path, "kshield-disarm.conf")
        if os.path.exists(snap_modprobe):
            if "kshield-disarm.conf" in digests:
                with open(snap_modprobe, "rb") as f:
                    actual = hashlib.sha256(f.read()).hexdigest()
                if actual != digests["kshield-disarm.conf"]:
                    print(f"[ERROR] Integrity verification failed for {snap_modprobe}. Snapshot may be corrupted.")
                    return False
            shutil.copy2(snap_modprobe, target_modprobe)
            print(f"  • Restored {target_modprobe} (SHA-256 verified)")
        else:
            if os.path.exists(target_modprobe):
                os.remove(target_modprobe)
                print(f"  • Removed {target_modprobe} (did not exist at baseline)")

        # 2. Restore or remove sysctl config
        target_sysctl = "/etc/sysctl.d/99-kshield.conf"
        snap_sysctl = os.path.join(snap_path, "99-kshield.conf")
        if os.path.exists(snap_sysctl):
            if "99-kshield.conf" in digests:
                with open(snap_sysctl, "rb") as f:
                    actual = hashlib.sha256(f.read()).hexdigest()
                if actual != digests["99-kshield.conf"]:
                    print(f"[ERROR] Integrity verification failed for {snap_sysctl}. Snapshot may be corrupted.")
                    return False
            shutil.copy2(snap_sysctl, target_sysctl)
            print(f"  • Restored {target_sysctl} (SHA-256 verified)")
        else:
            if os.path.exists(target_sysctl):
                os.remove(target_sysctl)
                print(f"  • Removed {target_sysctl} (did not exist at baseline)")

        # 3. Reload live sysctls
        sysctl_baseline = os.path.join(snap_path, "sysctl_baseline.json")
        if os.path.exists(sysctl_baseline):
            try:
                with open(sysctl_baseline, "r") as f:
                    vals = json.load(f)
                for k, v in vals.items():
                    # Attempt live reset
                    try:
                        p = os.path.join("/proc/sys", k.replace(".", "/"))
                        if os.path.exists(p):
                            with open(p, "w") as sf:
                                sf.write(str(v))
                    except Exception as ex:
                        # Some sysctls (e.g. kexec_load_disabled, unprivileged_bpf_disabled=2) are one-way locks
                        pass
                print("  • Reverted live sysctl runtime parameters.")
            except Exception as e:
                print(f"  [WARN] Sysctl live revert warning: {e}")

        print("[OK] Snapshot restoration complete.")
        return True


# ============================================================================
# 4. EXPLOIT SANDBOX & PROBING SUITE
# ============================================================================

class KShieldSandbox:
    @staticmethod
    def test_normal_workload() -> bool:
        print("[1/3] Testing standard workload execution...")
        try:
            # File I/O
            tmp_path = "/tmp/_kshield_test.tmp"
            with open(tmp_path, "w") as f:
                f.write("Aegis-Kernel Verification")
            with open(tmp_path, "r") as f:
                content = f.read()
            os.unlink(tmp_path)
            assert content == "Aegis-Kernel Verification"

            # Networking
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.close()

            # Threading
            def worker(res):
                res["val"] = 42
            r = {}
            t = threading.Thread(target=worker, args=(r,))
            t.start()
            t.join()
            assert r.get("val") == 42

            # Subprocess
            p = subprocess.run(["echo", "kshield-ok"], capture_output=True, text=True)
            assert "kshield-ok" in p.stdout

            print("  [OK] Standard POSIX Workload: 100% OPERATIONAL")
            return True
        except Exception as e:
            print(f"  [ERROR] Standard POSIX Workload Failed: {e}")
            return False

    @staticmethod
    def test_blocked_primitives() -> Dict[str, Any]:
        print("[2/3] Probing blocked weaponized attack primitives...")
        results = {}

        # Detect Seccomp filter status of the current execution environment
        seccomp_mode = 0
        try:
            with open("/proc/self/status", "r") as f:
                for line in f:
                    if line.startswith("Seccomp:"):
                        seccomp_mode = int(line.split(":")[1].strip())
                        break
        except Exception:
            pass

        # 1. AF_ALG crypto socket
        try:
            s = socket.socket(38, socket.SOCK_SEQPACKET, 0)
            s.close()
            if seccomp_mode > 0:
                print("  [ERROR] Probe 1 (AF_ALG): FAILED — Socket created successfully under Seccomp!")
                results["af_alg"] = "UNPROTECTED"
            else:
                print("  [WARN] Probe 1 (AF_ALG): Unconfined host (Seccomp: 0). Gated inside container workloads via seccomp-kshield-default.json.")
                results["af_alg"] = "HOST_PERMITTED"
        except PermissionError:
            print("  [OK] Probe 1 (AF_ALG): BLOCKED (PermissionError / EACCES)")
            results["af_alg"] = "BLOCKED"
        except OSError as e:
            if getattr(e, "errno", None) in (1, 13):
                print(f"  [OK] Probe 1 (AF_ALG): BLOCKED (errno={e.errno})")
                results["af_alg"] = "BLOCKED"
            elif getattr(e, "errno", None) == 97:
                print("  [INFO] Probe 1 (AF_ALG): KERNEL UNSUPPORTED (EAFNOSUPPORT)")
                results["af_alg"] = "UNSUPPORTED"
            else:
                print(f"  [WARN] Probe 1 (AF_ALG): Unexpected OSError: {e}")
                results["af_alg"] = f"ERROR_{e}"

        # 2. userfaultfd
        if NR_userfaultfd > 0:
            ret = libc.syscall(NR_userfaultfd, 0)
            err = ctypes.get_errno()
            if ret == -1 and err in (1, 13):
                print(f"  [OK] Probe 2 (userfaultfd): BLOCKED by Seccomp/Sysctl (errno={err})")
                results["userfaultfd"] = "BLOCKED"
            elif ret == -1 and err == 38:
                print("  [INFO] Probe 2 (userfaultfd): NOT IMPLEMENTED IN KERNEL (ENOSYS)")
                results["userfaultfd"] = "UNSUPPORTED"
            elif ret >= 0:
                os.close(ret)
                print("  [ERROR] Probe 2 (userfaultfd): FAILED — Syscall succeeded! (Not blocked)")
                results["userfaultfd"] = "UNPROTECTED"
            else:
                print(f"  [WARN] Probe 2 (userfaultfd): Denied or unexpected (ret={ret}, errno={err})")
                results["userfaultfd"] = f"RET_{ret}_ERR_{err}"

        # 3. io_uring_setup
        if NR_io_uring_setup > 0:
            ret = libc.syscall(NR_io_uring_setup, 32, None)
            err = ctypes.get_errno()
            if ret == -1 and err in (1, 13):
                print(f"  [OK] Probe 3 (io_uring_setup): BLOCKED by Seccomp (errno={err})")
                results["io_uring_setup"] = "BLOCKED"
            elif ret == -1 and err == 38:
                print("  [INFO] Probe 3 (io_uring_setup): NOT IMPLEMENTED IN KERNEL (ENOSYS)")
                results["io_uring_setup"] = "UNSUPPORTED"
            elif ret == -1 and err == 14 and seccomp_mode == 0:
                print("  [WARN] Probe 3 (io_uring_setup): Unconfined host (EFAULT on null params). Gated inside container workloads via seccomp-kshield-default.json.")
                results["io_uring_setup"] = "HOST_PERMITTED"
            elif ret >= 0:
                os.close(ret)
                print("  [ERROR] Probe 3 (io_uring_setup): FAILED — Syscall succeeded! (Not blocked)")
                results["io_uring_setup"] = "UNPROTECTED"
            else:
                print(f"  [WARN] Probe 3 (io_uring_setup): Denied or unexpected (ret={ret}, errno={err})")
                results["io_uring_setup"] = f"RET_{ret}_ERR_{err}"

        # 4. kexec_load
        if NR_kexec_load > 0:
            ret = libc.syscall(NR_kexec_load, 0, 0, None, 0)
            err = ctypes.get_errno()
            if ret == -1 and err in (1, 13):
                print(f"  [OK] Probe 4 (kexec_load): BLOCKED by Seccomp/Sysctl (errno={err})")
                results["kexec_load"] = "BLOCKED"
            elif ret >= 0:
                print("  [ERROR] Probe 4 (kexec_load): FAILED — Syscall succeeded! (Not blocked)")
                results["kexec_load"] = "UNPROTECTED"
            else:
                print(f"  [INFO] Probe 4 (kexec_load): Denied or unsupported (errno={err})")
                results["kexec_load"] = f"ERR_{err}"

        return results

    @staticmethod
    def benchmark_latency(iterations: int = 100_000) -> float:
        print(f"[3/3] Micro-benchmarking syscall evaluation overhead ({iterations:,} iterations)...")
        start = time.perf_counter_ns()
        for _ in range(iterations):
            libc.syscall(NR_getpid)
        end = time.perf_counter_ns()

        total_ns = end - start
        avg_ns = total_ns / iterations
        print(f"  • Average Syscall Latency: {avg_ns:.2f} ns/call")
        print(f"  • Throughput Capability: {1_000_000_000 / avg_ns:,.0f} syscalls/second per core")
        return avg_ns


